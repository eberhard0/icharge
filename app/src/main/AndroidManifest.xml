<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Distance to each charger and the "near me" order. Android 12+ wants coarse requested with fine. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Map tiles and refreshing the station list (Open Charge Map, OpenStreetMap). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+: lets the app see which navigation apps can take a geo: / waze: link. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="waze" />
        </intent>
    </queries>

    <application
        android:name=".IChargeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.iCharge">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Google Maps links. Android gives them to Google Maps itself unless the user adds iCharge
                 under Settings › Apps › iCharge › Open by default; sharing from Maps always works. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="goo.gl" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" android:pathPrefix="/maps" />
            </intent-filter>
            <!-- "Share" a place from Google Maps straight into the trip planner. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Android Auto: chargers on the car screen (points-of-interest category). -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="1" />
        <service
            android:name=".car.ChargerCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>
    </application>

</manifest>
